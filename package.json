{
  "name": "wyrd-foo",
  "type": "module",
  "version": "2.2.1",
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "test": "pnpm test:schema && pnpm test:publisher && pnpm test:site && pnpm test:build",
    "test:schema": "node --test 'test/schema/**/*.test.ts'",
    "test:publisher": "node --test 'test/publisher/**/*.test.ts'",
    "test:site": "vitest run --project unit",
    "test:build": "node --test --test-concurrency=1 'test/build/**/*.test.ts'",
    "test:template": "node --test 'test/template/**/*.test.ts'",
    "build:fixtures": "astro build --root test/fixtures/head-site && pnpm build:home-fixture && pnpm build:docs-fixture && pnpm build:product-fixture",
    "build:home-fixture": "WYRD_CONTENT_DIR=test/fixtures/home-content astro build --outDir dist-fixtures/home",
    "build:docs-fixture": "WYRD_CONTENT_DIR=test/fixtures/docs-content astro build --outDir dist-fixtures/docs && pagefind --site dist-fixtures/docs",
    "build:product-fixture": "WYRD_CONTENT_DIR=test/fixtures/product-content astro build --outDir dist-fixtures/products && pagefind --site dist-fixtures/products",
    "test:dist": "pnpm build:fixtures && vitest run --project dist",
    "test:browser": "pnpm build:home-fixture && pnpm build:docs-fixture && pnpm build:product-fixture && playwright test -c test/browser/playwright.config.ts",
    "typecheck": "pnpm typecheck:schema && pnpm typecheck:site",
    "typecheck:schema": "tsc -p tsconfig.schema.json",
    "typecheck:site": "node scripts/typecheck-site.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm test:dist && pnpm test:browser"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.0",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.2.1",
    "astro": "^6.0.1",
    "isomorphic-git": "^1.44.3",
    "tailwindcss": "^4.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "@types/semver": "^7.8.0",
    "ajv": "^8.20.0",
    "node-html-parser": "^9.0.5",
    "pagefind": "^1.5.2",
    "semver": "^7.8.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
