{
  "name": "wyrd-foo",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "test": "pnpm test:schema && pnpm test:site",
    "test:schema": "node --test 'test/schema/**/*.test.ts'",
    "test:site": "vitest run --project unit",
    "build:fixtures": "astro build --root test/fixtures/head-site",
    "test:dist": "pnpm build:fixtures && vitest run --project dist",
    "typecheck": "pnpm typecheck:schema && pnpm typecheck:site",
    "typecheck:schema": "tsc -p tsconfig.schema.json",
    "typecheck:site": "astro check",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm test:dist"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.2.1",
    "astro": "^6.0.1",
    "tailwindcss": "^4.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^24.19.2",
    "@types/semver": "^7.8.0",
    "ajv": "^8.20.0",
    "node-html-parser": "^9.0.5",
    "pagefind": "^1.5.2",
    "semver": "^7.8.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
