---
/*
 * The shared <head> for every page: title, description, canonical, sitemap, favicon,
 * Open Graph and Twitter meta, the fonts and theme stylesheet, and the inline
 * script that sets the theme before the first paint.
 */
import "../styles/global.css";
import { resolveFavicon, resolveSocialImage, type HeadProduct } from "../lib/head";

interface Props {
  title: string;
  description?: string;
  /** The product this page belongs to (its product page or a docs page). */
  product?: HeadProduct;
  /** A page served at URLs that are not its own (the 404 page): no canonical
   * URL, no og:url, and crawlers are told not to index it. */
  noindex?: boolean;
}
const { title, description, product, noindex = false } = Astro.props;

const site = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, site).href;
const favicon = resolveFavicon(product);
const socialImage = new URL(resolveSocialImage(product), site).href;
---

<meta charset="utf-8" />
<script is:inline>
  // Set the theme before the first paint: the stored choice, else the system
  // preference, else dark. lib/theme.ts stores the choice under the same key.
  (() => {
    let theme;
    try {
      theme = localStorage.getItem("wyrd-theme");
    } catch {}
    if (theme !== "light" && theme !== "dark") {
      theme = matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
    }
    document.documentElement.dataset.theme = theme;
  })();
</script>
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="color-scheme" content="dark light" />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>
{description && <meta name="description" content={description} />}
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="icon" type={favicon.type} href={favicon.href} />
{!product && <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />}
{!product && <link rel="apple-touch-icon" href="/apple-touch-icon.png" />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Wyrd Tools" />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
{!noindex && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={socialImage} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
<meta name="twitter:image" content={socialImage} />
