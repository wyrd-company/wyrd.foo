---
/*
 * The content column of a docs page: breadcrumb, title, the page body as
 * prose (lead paragraph, tip callouts), an optional slot above the prose,
 * the pager and the version footer.
 */
import DocsVersionFooter from "./DocsVersionFooter.astro";
import type { DocsPage, DocsProduct } from "../../lib/docs";
import { pageHref } from "../../lib/docs-pages";

interface Props {
  product: DocsProduct;
  title: string;
  section: string | null;
  prev?: DocsPage;
  next?: DocsPage;
}
const { product, title, section, prev, next } = Astro.props;
---

<article class="docs-article">
  <nav class="docs-crumbs" aria-label="Breadcrumb" data-pagefind-ignore>
    <a href="/docs/">Docs</a>
    <span aria-hidden="true">/</span>
    <a href={pageHref(product.key, product.first.slug)}>{product.name}</a>
    {
      section && (
        <>
          <span aria-hidden="true">/</span>
          <span>{section}</span>
        </>
      )
    }
  </nav>
  <h1 data-pagefind-meta="title">{title}</h1>
  <slot name="before" />
  <div class="docs-prose"><slot /></div>
  {
    (prev || next) && (
      <nav class="docs-pager" aria-label="Previous and next page" data-pagefind-ignore>
        {prev ? (
          <a class="docs-pager-prev" href={pageHref(prev.key, prev.slug)}>
            <span>← Previous</span>
            <strong>{prev.title}</strong>
          </a>
        ) : (
          <span />
        )}
        {next ? (
          <a class="docs-pager-next" href={pageHref(next.key, next.slug)}>
            <span>Next →</span>
            <strong>{next.title}</strong>
          </a>
        ) : (
          <span />
        )}
      </nav>
    )
  }
  <footer class="docs-article-foot">
    <DocsVersionFooter product={product} />
  </footer>
</article>

<style>
  .docs-article {
    max-width: 720px;
  }
  .docs-crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-family: var(--font-code);
    font-size: 12.5px;
    color: var(--text-faint);
  }
  .docs-crumbs a {
    color: var(--text-2);
  }
  h1 {
    margin: 12px 0 20px;
    font-size: clamp(30px, 3.4vw, 40px);
    line-height: 1.12;
    letter-spacing: -0.03em;
    font-weight: 700;
  }
  .docs-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 56px;
  }
  .docs-pager a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 16px;
    border: 1px solid var(--divider);
    border-radius: 8px;
    color: var(--text);
    transition:
      border-color 0.15s,
      background 0.15s;
  }
  .docs-pager a:hover {
    border-color: var(--accent);
    background: var(--accent-tint);
    text-decoration: none;
  }
  .docs-pager span {
    font-size: 12.5px;
    color: var(--text-faint);
  }
  .docs-pager strong {
    font-weight: 600;
  }
  .docs-pager-next {
    text-align: right;
  }
  .docs-article-foot {
    margin-top: 40px;
    padding-top: 16px;
    border-top: 1px solid var(--divider);
  }

  /* Prose: the rendered Markdown. */
  .docs-prose {
    font-size: 16px;
    line-height: 1.7;
    color: var(--text);
  }
  /* The page title is the h1 above; a leading h1 in the body (a changelog's
     "# Changelog") would repeat it. */
  .docs-prose :global(> h1:first-child) {
    display: none;
  }
  .docs-prose :global(> p:first-child),
  .docs-prose :global(> h1:first-child + p) {
    font-size: 18.5px;
    line-height: 1.6;
    color: var(--text-2);
  }
  .docs-prose :global(:is(h2, h3, h4)) {
    scroll-margin-top: calc(var(--docs-top, 105px) + 8px);
    letter-spacing: -0.015em;
    line-height: 1.3;
    font-weight: 600;
  }
  .docs-prose :global(h2) {
    margin: 48px 0 12px;
    font-size: 24px;
  }
  .docs-prose :global(h3) {
    margin: 32px 0 8px;
    font-size: 19px;
  }
  .docs-prose :global(h4) {
    margin: 24px 0 8px;
    font-size: 16px;
  }
  .docs-prose :global(p),
  .docs-prose :global(ul),
  .docs-prose :global(ol) {
    margin: 0 0 16px;
  }
  .docs-prose :global(li + li) {
    margin-top: 4px;
  }
  .docs-prose :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .docs-prose :global(:not(pre) > code) {
    font-size: 0.87em;
    padding: 1px 5px;
    border-radius: 4px;
    background: var(--surface-2);
    border: 1px solid var(--divider);
  }
  .docs-prose :global(pre) {
    margin: 0 0 20px;
    border: 1px solid var(--divider);
  }
  .docs-prose :global(blockquote) {
    margin: 0 0 20px;
    padding: 12px 16px;
    border-left: 3px solid var(--accent);
    border-radius: 0 8px 8px 0;
    background: var(--accent-tint);
    color: var(--text);
  }
  .docs-prose :global(blockquote > :last-child) {
    margin-bottom: 0;
  }
  .docs-prose :global(table) {
    width: 100%;
    margin: 0 0 20px;
    border-collapse: collapse;
    font-size: 14.5px;
  }
  .docs-prose :global(:is(th, td)) {
    padding: 8px 12px;
    border-bottom: 1px solid var(--divider);
    text-align: left;
    vertical-align: top;
  }
  .docs-prose :global(th) {
    color: var(--text-2);
    font-weight: 600;
  }
  .docs-prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--divider);
    margin: 32px 0;
  }
  .docs-prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }
</style>
