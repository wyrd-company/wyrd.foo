---
/*
 * The install block a page asks for with `install: true`: the primary kind's
 * default install command with Copy, and a link to every install method on
 * the product page. For apt and rpm the site's repository setup sits above
 * the install line in a closed <details> (the product page's code block does
 * the same), and Copy takes the setup and the install line.
 */
import type { DocsProduct } from "../../lib/docs";
import { primaryInstall } from "../../lib/docs-pages";

interface Props {
  product: DocsProduct;
}
const { product } = Astro.props;
const { label, command, setup } = primaryInstall(product.data.kinds[0]);
const copyText = setup ? `${setup.code}\n${command}` : command;
---

<section class="docs-install" aria-label={`Install ${product.name}`} data-pagefind-ignore>
  <div class="docs-install-head">
    <span class="docs-install-label">{label}</span>
    <a href={`/tools/${product.key}#install`}>All install methods →</a>
  </div>
  <div class:list={["docs-install-code", { "has-setup": setup }]}>
    {
      setup && (
        <details class="docs-install-setup" data-code-setup>
          <summary>{setup.hint}</summary>
          <pre>{setup.code}</pre>
        </details>
      )
    }
    <pre><code>{command}</code></pre>
    <button type="button" data-copy-text={copyText} aria-label={`Copy the ${label} command`}>Copy</button>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy-text]").forEach((button) => {
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copyText!);
        button.textContent = "Copied";
      } catch {
        button.textContent = "Copy failed";
      }
      setTimeout(() => (button.textContent = "Copy"), 1600);
    });
  });
</script>

<style>
  .docs-install {
    margin: 0 0 28px;
    border: 1px solid var(--divider);
    border-radius: 10px;
    background: var(--surface);
    overflow: hidden;
  }
  .docs-install-head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 14px;
    font-size: 13px;
    border-bottom: 1px solid var(--divider);
  }
  .docs-install-label {
    font-family: var(--font-code);
    color: var(--text-2);
  }
  .docs-install-code {
    position: relative;
  }
  .docs-install-code {
    background: var(--code-bg);
  }
  .docs-install-code pre {
    margin: 0;
    border-radius: 0;
    padding-right: 84px;
  }
  .docs-install-setup summary {
    display: block;
    padding: 12px 84px 0 18px;
    color: #8e8e97;
    font: 400 12.5px/22px var(--font-text);
    cursor: pointer;
    list-style: none;
  }
  .docs-install-setup summary::-webkit-details-marker {
    display: none;
  }
  .docs-install-setup summary::before {
    content: "▸";
    content: "▸" / "";
    display: inline-block;
    width: 1.1em;
    transition: transform 120ms;
  }
  .docs-install-setup[open] summary::before {
    transform: rotate(90deg);
  }
  .docs-install-setup summary:hover {
    color: #ededef;
  }
  .docs-install-setup summary:focus-visible {
    outline: 2px solid #6aa5ff;
    outline-offset: -2px;
  }
  .docs-install-setup pre {
    padding-top: 2px;
    padding-bottom: 0;
  }
  .has-setup > pre:last-of-type {
    padding-top: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .docs-install-setup summary::before {
      transition: none;
    }
  }
  .docs-install-code button {
    position: absolute;
    top: 10px;
    right: 10px;
    padding: 4px 10px;
    font-family: var(--font-code);
    font-size: 12px;
    color: var(--code-text);
    background: transparent;
    border: 1px solid #3a3a42;
    border-radius: 6px;
    cursor: pointer;
  }
  .docs-install-code button:hover {
    border-color: #6aa5ff;
  }
</style>
