---
/*
 * Site search, backed by the Pagefind index that `pnpm build` writes to
 * dist/pagefind/. When the page belongs to a product (its docs, or later its
 * product page), that product's results are boosted rather than filtered, so
 * a strong match elsewhere can still outrank a weak local one.
 */
interface Props {
  /** Slug of the product this page belongs to, if any. */
  product?: string;
  /** Display name of that product. */
  productName?: string;
}
const { product, productName } = Astro.props;
---

<button
  type="button"
  class="wsearch-trigger"
  data-wsearch-open
  aria-haspopup="dialog"
  aria-label={productName ? `Search (${productName} results first)` : "Search"}
>
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <circle cx="11" cy="11" r="7"></circle><path d="M20 20l-4-4"></path>
  </svg>
  <span class="wsearch-trigger-label">Search</span>
  <kbd>⌘K</kbd>
</button>

<dialog class="wsearch" data-product={product} data-product-name={productName} aria-label="Search">
  <div class="wsearch-bar">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <circle cx="11" cy="11" r="7"></circle><path d="M20 20l-4-4"></path>
    </svg>
    <input
      type="search"
      class="wsearch-input"
      placeholder={productName ? `Search ${productName} and all tools` : "Search tools and docs"}
      aria-label="Search"
      aria-controls="wsearch-results"
      autocomplete="off"
      spellcheck="false"
    />
    <kbd>esc</kbd>
  </div>
  <ul id="wsearch-results" class="wsearch-results" role="listbox" aria-label="Results"></ul>
  <p class="wsearch-status" aria-live="polite"></p>
  <div class="wsearch-foot">
    <span><kbd>↑</kbd><kbd>↓</kbd> Move</span>
    <span><kbd>↵</kbd> Open</span>
    {productName && <span class="wsearch-scope">{productName} results first</span>}
    <span class="wsearch-by">Search by Pagefind</span>
  </div>
</dialog>

<script>
  type PagefindResult = {
    id: string;
    score: number;
    data: () => Promise<PagefindData>;
  };
  type PagefindData = {
    url: string;
    excerpt: string;
    meta: Record<string, string>;
    sub_results?: { title: string; url: string }[];
  };
  type Pagefind = {
    search: (q: string, opts?: object) => Promise<{ results: PagefindResult[] } | null>;
    debouncedSearch: (q: string, opts?: object, ms?: number) => Promise<{ results: PagefindResult[] } | null>;
  };

  // How much a result from the current product counts relative to others.
  const PRODUCT_BOOST = 3;
  const MAX_RESULTS = 8;

  const dialog = document.querySelector<HTMLDialogElement>("dialog.wsearch")!;
  const input = dialog.querySelector<HTMLInputElement>(".wsearch-input")!;
  const list = dialog.querySelector<HTMLUListElement>(".wsearch-results")!;
  const status = dialog.querySelector<HTMLParagraphElement>(".wsearch-status")!;
  const product = dialog.dataset.product || "";

  let pagefind: Pagefind | null = null;
  let active = -1;
  let seq = 0;

  async function load(): Promise<Pagefind | null> {
    if (pagefind) return pagefind;
    try {
      // Built by `pagefind --site dist` after `astro build`; absent in `astro dev`.
      const url = "/pagefind/pagefind.js";
      pagefind = (await import(/* @vite-ignore */ url)) as Pagefind;
      return pagefind;
    } catch {
      status.textContent = "Search is available in the built site (run pnpm build).";
      return null;
    }
  }

  function open() {
    if (dialog.open) return;
    dialog.showModal();
    input.select();
    load();
  }

  async function search(q: string) {
    const run = ++seq;
    const pf = await load();
    if (!pf) return;
    if (!q.trim()) {
      list.replaceChildren();
      status.textContent = "";
      return;
    }
    const all = await pf.debouncedSearch(q, {}, 150);
    if (all === null || run !== seq) return; // superseded by a newer keystroke

    // Ids of results that belong to the current product get the boost.
    let local = new Set<string>();
    if (product) {
      const scoped = await pf.search(q, { filters: { product } });
      if (run !== seq) return;
      local = new Set((scoped?.results ?? []).map((r) => r.id));
    }

    const ranked = all.results
      .map((r) => ({ r, s: r.score * (local.has(r.id) ? PRODUCT_BOOST : 1) }))
      .sort((a, b) => b.s - a.s)
      .slice(0, MAX_RESULTS);
    const data = await Promise.all(ranked.map((x) => x.r.data()));
    if (run !== seq) return;

    render(data, ranked.map((x) => local.has(x.r.id)));
    status.textContent = data.length
      ? `${all.results.length} result${all.results.length === 1 ? "" : "s"}`
      : `No results for “${q}”`;
  }

  function render(items: PagefindData[], isLocal: boolean[]) {
    active = items.length ? 0 : -1;
    list.replaceChildren(
      ...items.map((d, i) => {
        const li = document.createElement("li");
        li.setAttribute("role", "option");
        li.id = `wsearch-opt-${i}`;
        li.className = "wsearch-item";
        if (i === 0) li.setAttribute("aria-selected", "true");

        const a = document.createElement("a");
        a.href = d.url;
        a.className = "wsearch-link";

        const head = document.createElement("span");
        head.className = "wsearch-head";
        const title = document.createElement("span");
        title.className = "wsearch-title";
        title.textContent = d.meta.title || d.url;
        const where = document.createElement("span");
        where.className = "wsearch-where" + (isLocal[i] ? " is-local" : "");
        where.textContent = d.meta.productName || "";
        head.append(title, where);

        const excerpt = document.createElement("span");
        excerpt.className = "wsearch-excerpt";
        // Pagefind escapes page text and wraps matches in <mark>.
        excerpt.innerHTML = d.excerpt;
        a.append(head, excerpt);

        const subs = (d.sub_results ?? []).filter((s) => s.url !== d.url).slice(0, 3);
        if (subs.length) {
          const ul = document.createElement("span");
          ul.className = "wsearch-subs";
          for (const s of subs) {
            const sa = document.createElement("a");
            sa.href = s.url;
            sa.textContent = `# ${s.title}`;
            ul.append(sa);
          }
          li.append(a, ul);
        } else {
          li.append(a);
        }
        return li;
      }),
    );
    input.setAttribute("aria-activedescendant", items.length ? "wsearch-opt-0" : "");
  }

  function move(delta: number) {
    const items = [...list.children] as HTMLElement[];
    if (!items.length) return;
    items[active]?.removeAttribute("aria-selected");
    active = (active + delta + items.length) % items.length;
    items[active].setAttribute("aria-selected", "true");
    items[active].scrollIntoView({ block: "nearest" });
    input.setAttribute("aria-activedescendant", items[active].id);
  }

  document.querySelectorAll("[data-wsearch-open]").forEach((b) => b.addEventListener("click", open));
  document.addEventListener("keydown", (e) => {
    const typing = e.target instanceof HTMLElement && e.target.closest("input, textarea, [contenteditable]");
    if ((e.key === "k" && (e.metaKey || e.ctrlKey)) || (e.key === "/" && !typing)) {
      e.preventDefault();
      open();
    }
  });
  input.addEventListener("input", () => search(input.value));
  input.addEventListener("keydown", (e) => {
    if (e.key === "ArrowDown") { e.preventDefault(); move(1); }
    else if (e.key === "ArrowUp") { e.preventDefault(); move(-1); }
    else if (e.key === "Enter") {
      const link = list.children[active]?.querySelector<HTMLAnchorElement>("a.wsearch-link");
      if (link) { e.preventDefault(); location.href = link.href; }
    }
  });
  // Clicking the backdrop (the dialog element itself) closes it.
  dialog.addEventListener("click", (e) => { if (e.target === dialog) dialog.close(); });
</script>

<style is:global>
  .wsearch-trigger {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 34px;
    padding: 0 8px 0 10px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
    background: var(--panel-2);
    border: 1px solid var(--rule);
    border-radius: 3px;
    cursor: pointer;
  }
  .wsearch-trigger:hover { color: var(--accent); border-color: var(--accent); }
  .wsearch-trigger kbd,
  .wsearch kbd {
    font-family: var(--mono);
    font-size: 10.5px;
    padding: 1px 5px;
    border: 1px solid var(--rule);
    border-radius: 2px;
    color: var(--ink-soft);
  }

  .wsearch {
    width: min(720px, calc(100vw - 32px));
    max-height: min(640px, calc(100vh - 96px));
    margin: 72px auto auto;
    padding: 0;
    display: none;
    flex-direction: column;
    background: var(--panel);
    color: var(--ink);
    border: 1px solid var(--rule);
    border-radius: 6px;
    box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.8);
    /* The dialog lives inside the masthead nav; don't inherit its type. */
    font-family: var(--body);
    font-size: 15px;
    line-height: 1.5;
    letter-spacing: normal;
    text-transform: none;
    text-align: left;
  }
  .wsearch[open] { display: flex; }
  .wsearch::backdrop { background: rgba(4, 8, 14, 0.7); }

  .wsearch-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 16px;
    height: 56px;
    border-bottom: 1px solid var(--rule-soft);
    color: var(--accent);
  }
  .wsearch-input {
    flex: 1;
    min-width: 0;
    height: 100%;
    background: transparent;
    border: 0;
    outline: none;
    color: var(--ink);
    font-family: var(--body);
    font-size: 17px;
  }
  .wsearch-input::-webkit-search-cancel-button { display: none; }

  .wsearch-results { list-style: none; margin: 0; padding: 6px; overflow-y: auto; }
  .wsearch-item { border-radius: 4px; padding: 10px 12px; }
  .wsearch-item[aria-selected="true"] { background: var(--accent-dim); }
  .wsearch-link { display: flex; flex-direction: column; gap: 4px; text-decoration: none; color: inherit; }
  .wsearch-head { display: flex; align-items: baseline; gap: 10px; }
  .wsearch-title { font-weight: 600; font-size: 15px; color: var(--ink); }
  .wsearch-where { font-family: var(--mono); font-size: 11.5px; color: var(--faint); }
  .wsearch-where.is-local { color: var(--accent); }
  .wsearch-excerpt { font-size: 13.5px; line-height: 1.5; color: var(--ink-soft); }
  .wsearch-excerpt mark { background: var(--accent-dim); color: var(--ink); border-radius: 2px; padding: 0 2px; }
  .wsearch-subs { display: flex; flex-wrap: wrap; gap: 4px 14px; margin-top: 6px; }
  .wsearch-subs a { font-size: 13px; color: var(--ink-soft); text-decoration: none; }
  .wsearch-subs a:hover { color: var(--accent); }

  .wsearch-status { margin: 0; padding: 0 18px 8px; font-size: 12.5px; color: var(--faint); }
  .wsearch-status:empty { display: none; }
  .wsearch-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 16px;
    padding: 10px 16px;
    border-top: 1px solid var(--rule-soft);
    font-size: 12px;
    color: var(--faint);
  }
  .wsearch-foot span { display: inline-flex; align-items: center; gap: 4px; }
  .wsearch-scope { color: var(--accent); }
  .wsearch-by { margin-left: auto; }

  @media (max-width: 640px) {
    .wsearch-trigger-label, .wsearch-trigger kbd { display: none; }
    .wsearch { margin-top: 16px; }
  }
</style>
