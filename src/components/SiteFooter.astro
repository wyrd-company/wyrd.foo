---
/* The site footer, including issue drafts (implements: site). */
import { issueReportUrl, type IssueReportProduct } from "../lib/issue-report";
interface Props {
  title?: string;
  pageUrl?: string;
  reportProduct?: IssueReportProduct;
}
const { title = "Wyrd Tools", pageUrl = Astro.url.href, reportProduct } = Astro.props;
---

<footer class="site-footer">
  <div class="site-footer-inner site-width">
    <span class="site-footer-name">Wyrd Company</span>
    <a href="https://wyrd.company">wyrd.company</a>
    {reportProduct && <a href={issueReportUrl(pageUrl, title, reportProduct)}>Report a problem with {reportProduct.name}</a>}
    <a href={issueReportUrl(pageUrl, title)}>Report a site problem</a>
    <span class="site-footer-note">Tools released under open-source licenses.</span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--divider);
  }
  .site-footer-inner {
    min-height: 72px;
    padding-block: 16px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 24px;
    font-size: 13.5px;
    color: var(--text-faint);
  }
  .site-footer-name {
    font-weight: 600;
    color: var(--text);
  }
  .site-footer-note {
    margin-left: auto;
  }
</style>
