---
/*
 * The install block of a dev container feature (a devcontainer.json snippet
 * that adds it) or a dev container image (its reference and install method
 * tabs, then the tags table of its registry tags).
 */
import InstallManifest from "./InstallManifest.astro";
import CodeBlock from "./CodeBlock.astro";
import { devcontainerFeatureSnippet } from "../../lib/install-blocks";
import { containerImageOptions } from "../../lib/container-install";
import type { KindBlock } from "../../schema/index";

interface Props {
  productKey: string;
  block: Extract<KindBlock, { kind: "devcontainer-feature" | "devcontainer-image" }>;
}
const { block, productKey } = Astro.props;
const imageOptions = block.kind === "devcontainer-image" ? containerImageOptions(block, () => "") : [];
---

<div class="install-card" data-install-block={block.kind}>
  {
    block.kind === "devcontainer-feature" ? (
      <div class="install-body">
        <p class="install-label">Add to devcontainer.json</p>
        <CodeBlock code={devcontainerFeatureSnippet(block.ref)} label="devcontainer.json features" />
      </div>
    ) : (
      <>
        <div class="install-body">
          <div>
            <p class="install-label">Image</p>
            <CodeBlock code={block.ref} label="Image reference" />
          </div>
          <div class="install-pills" role="tablist" aria-label="Image install method">
            {imageOptions.map((option, index) => (
              <button
                type="button"
                role="tab"
                class="install-pill"
                id={`install-image-${option.id}-tab`}
                aria-controls={`install-image-${option.id}`}
                aria-selected={index === 0 ? "true" : "false"}
                tabindex={index === 0 ? 0 : -1}
              >
                {option.label}
              </button>
            ))}
          </div>
          {imageOptions.map((option, index) => (
            <div
              role="tabpanel"
              id={`install-image-${option.id}`}
              aria-labelledby={`install-image-${option.id}-tab`}
              hidden={index !== 0}
            >
              {option.command ? <InstallManifest productKey={productKey} manifest={{ [option.id]: block[option.id as "compose" | "kubernetes"] }} /> : <>
                <p class="install-label">{option.instruction}</p>
                <CodeBlock code={option.code} label={option.label} />
              </>}

            </div>
          ))}
        </div>
        {block.tags && (
          <div class="install-body image-tags">
            <p class="install-label">Tags</p>
            <div class="image-tags-scroll">
              <table class="install-table">
                <thead>
                  <tr><th scope="col">Tag</th><th scope="col">Base</th><th scope="col">Architectures</th></tr>
                </thead>
                <tbody>
                  {block.tags.map((tag) => (
                    <tr>
                      <td><code>{tag.tag}</code></td>
                      <td>{tag.base ?? "—"}</td>
                      <td class="image-arch">{tag.architectures?.join(", ") ?? "—"}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )}
      </>
    )
  }
</div>

<style>
  [role="tablist"],
  [role="tabpanel"] {
    margin-top: 20px;
  }
  [role="tabpanel"] :global(.code-block + .code-block) {
    margin-top: 12px;
  }
  .image-tags {
    border-top: 1px solid var(--divider);
  }
  .image-tags-scroll {
    overflow-x: auto;
  }
  .image-arch {
    font-family: var(--font-code);
    font-size: 13px;
    color: var(--text-2);
  }
</style>
