---
/*
 * The product's media: the first item full width with its caption, then the
 * others as a numbered tour (for an app, the screenshot tour of its console).
 * MP4 and WebM files play as muted, looping video; every other file is an
 * image, GIFs included.
 */
import { isVideo } from "../../lib/product-media";

export interface MediaView {
  src: string;
  caption: string;
  alt?: string;
}

interface Props {
  media: MediaView[];
  /** The tour's heading; "Console tour" for an app. */
  tourTitle: string;
}
const { media, tourTitle } = Astro.props;
const [first, ...tour] = media;
---

<figure class="media-main">
  <div class="media-frame">
    {
      isVideo(first.src) ? (
        <video src={first.src} autoplay muted loop playsinline preload="metadata" aria-label={first.alt ?? first.caption} />
      ) : (
        <img src={first.src} alt={first.alt ?? first.caption} decoding="async" />
      )
    }
  </div>
  <figcaption>{first.caption}</figcaption>
</figure>
{
  tour.length > 0 && (
    <section class="media-tour" aria-labelledby="media-tour-title">
      <h3 class="media-tour-title" id="media-tour-title">{tourTitle}</h3>
      <ol class="media-tour-list">
        {tour.map((item, index) => (
          <li>
            <figure>
              <div class="media-frame">
                {isVideo(item.src) ? (
                  <video src={item.src} autoplay muted loop playsinline preload="metadata" aria-label={item.alt ?? item.caption} />
                ) : (
                  <img src={item.src} alt={item.alt ?? item.caption} loading="lazy" decoding="async" />
                )}
              </div>
              <figcaption>
                <span class="media-tour-step">{String(index + 2).padStart(2, "0")}</span>
                {item.caption}
              </figcaption>
            </figure>
          </li>
        ))}
      </ol>
    </section>
  )
}

<style>
  .media-main {
    margin: 56px 0 0;
  }
  figure {
    margin: 0;
  }
  .media-frame {
    overflow: hidden;
    border: 1px solid var(--divider);
    border-radius: 10px;
    background: var(--code-bg);
  }
  .media-frame img,
  .media-frame video {
    display: block;
    width: 100%;
    height: auto;
  }
  figcaption {
    margin-top: 10px;
    font-size: 13px;
    color: var(--text-faint);
  }
  .media-tour {
    margin-top: 40px;
  }
  .media-tour-title {
    margin: 0 0 16px;
    font-family: var(--font-code);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .media-tour-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .media-tour-list figcaption {
    display: flex;
    gap: 10px;
    color: var(--text-2);
    font-size: 14px;
  }
  .media-tour-step {
    font-family: var(--font-code);
    font-size: 12px;
    color: var(--accent);
    padding-top: 2px;
  }
</style>
