---
/*
 * A product's releases: the latest release (version, date and its GitHub
 * Release), then the changelog passed in the default slot. On the product
 * page the slot holds the latest changelog entry, followed by a link to all
 * releases; on the product's releases page it holds the full changelog.
 */
import ProductProse from "./ProductProse.astro";
import ReleaseEntry from "./ReleaseEntry.astro";
import { formatReleaseDate } from "../../lib/product-facts";

interface Props {
  release?: { version: string; date: Date; url?: string };
  /** What the default slot holds: the latest changelog entry, the full changelog, or nothing. */
  changelog?: "latest" | "full";
  /** The version text of the latest entry, shown when there is no release data. */
  entryVersion?: string;
  /** The "All releases" link after the latest entry. */
  allHref?: string;
}
const { release, changelog, entryVersion, allHref } = Astro.props;
const latest = release ?? (changelog === "latest" && entryVersion ? { version: entryVersion } : undefined);
---

{
  latest && (
    <div class="release-latest" data-release-latest>
      <span class="release-label">Latest</span>
      <span class="release-version">{latest.version}</span>
      {"date" in latest && <time datetime={formatReleaseDate(latest.date)}>{formatReleaseDate(latest.date)}</time>}
      {"url" in latest && latest.url && (
        <a class="release-link" href={latest.url}>
          Release notes on GitHub <span aria-hidden="true">↗</span>
        </a>
      )}
    </div>
  )
}
{
  changelog === "full" ? (
    <div class="release-log">
      <ProductProse>
        <slot />
      </ProductProse>
    </div>
  ) : changelog === "latest" ? (
    <>
      <ReleaseEntry>
        <slot />
      </ReleaseEntry>
      {allHref && (
        <a class="release-all" href={allHref}>
          All releases <span aria-hidden="true">→</span>
        </a>
      )}
    </>
  ) : (
    !latest && <p class="release-none">No releases yet.</p>
  )
}

<style>
  .release-latest {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 16px;
    margin-bottom: 28px;
    padding: 16px 20px;
    background: var(--accent-tint);
    border-radius: 8px;
    font-size: 14px;
  }
  .release-label {
    font-family: var(--font-code);
    font-size: 11.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .release-version {
    font-family: var(--font-code);
    font-size: 16px;
    font-weight: 600;
  }
  .release-latest time {
    font-family: var(--font-code);
    font-size: 13px;
    color: var(--text-2);
  }
  .release-link {
    margin-left: auto;
    font-weight: 500;
  }
  .release-all {
    display: inline-block;
    margin-top: 24px;
    font-size: 14px;
    font-weight: 500;
  }
  .release-none {
    margin: 0;
    color: var(--text-2);
  }
  /* The changelog's own "Changelog" title is the label of the version list. */
  .release-log :global(.product-prose > h3:first-child) {
    margin: 0 0 4px;
    font-family: var(--font-code);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .release-log :global(h4) {
    margin-top: 1.6em;
    padding-top: 1.2em;
    border-top: 1px solid var(--divider);
    font-family: var(--font-code);
    font-size: 17px;
    font-weight: 600;
  }
  .release-log :global(.product-prose > h3:first-child + h4),
  .release-log :global(.product-prose > h4:first-child) {
    padding-top: 0;
    border-top: 0;
  }
  .release-log :global(h5) {
    font-size: 13px;
    font-family: var(--font-code);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
</style>
