---
/*
 * The 404 page (docs/technical-designs/site.yml, not-found-page). Cloudflare
 * Pages serves dist/404.html, with status 404, for every URL that has no
 * page. It links home and to the catalog, and opens search. It is not in the
 * sitemap, the search index or /llms.txt.
 */
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="Page not found — Wyrd Tools" description="There is no page at this address." noindex>
  <section class="not-found site-width" aria-labelledby="not-found-title">
    <p class="not-found-code" aria-hidden="true">404</p>
    <h1 id="not-found-title">Page not found</h1>
    <p class="not-found-deck">There is no page at this address. The link may be wrong, or the page may have moved.</p>
    <p class="not-found-path" data-not-found-path hidden>Requested: <code></code></p>
    <div class="not-found-actions">
      <a class="button button-primary" href="/#catalog">Browse the catalog <span aria-hidden="true">→</span></a>
      <button type="button" class="button" data-wsearch-open>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle><path d="M20 20l-4-4"></path>
        </svg>
        Search
      </button>
      <a class="button" href="/">Go home</a>
    </div>
  </section>
</SiteLayout>

<script>
  import { issueReportUrl } from "../lib/issue-report";

  // The host serves this one file for every missing path.
  const report = document.querySelector<HTMLAnchorElement>("[data-site-report]");
  if (report) {
    const page = new URL(location.pathname, report.dataset.reportPage!);
    report.href = issueReportUrl(page.href, document.title);
  }

  // Show the path that has no page, so a mistyped address is easy to spot.
  const line = document.querySelector<HTMLElement>("[data-not-found-path]");
  if (line) {
    let path = location.pathname;
    try {
      path = decodeURI(path);
    } catch {
      // A malformed escape: show the path as it was sent.
    }
    line.querySelector("code")!.textContent = path;
    line.hidden = false;
  }
</script>

<style>
  .not-found {
    padding-block: 96px 120px;
  }
  .not-found-code {
    margin: 0 0 12px;
    font-family: var(--font-code);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--text-faint);
  }
  h1 {
    margin: 0;
    font-size: 40px;
    line-height: 1.12;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .not-found-deck {
    max-width: 560px;
    margin: 12px 0 0;
    font-size: 18.5px;
    color: var(--text-2);
  }
  .not-found-path {
    margin: 16px 0 0;
    font-size: 14px;
    color: var(--text-faint);
    overflow-wrap: anywhere;
  }
  .not-found-path code {
    padding: 2px 6px;
    font-size: 0.87em;
    color: var(--text);
    background: var(--surface-2);
    border-radius: 4px;
  }
  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 32px;
  }
  .button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    padding: 0 16px;
    border-radius: 8px;
    border: 1px solid var(--divider);
    background: var(--surface);
    color: var(--text);
    font-family: var(--font-text);
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
  }
  .button:hover {
    text-decoration: none;
    border-color: var(--text-faint);
  }
  .button-primary {
    border-color: transparent;
    background: var(--button);
    color: var(--button-text);
    font-weight: 600;
    padding-inline: 18px;
  }
  .button-primary:hover {
    border-color: transparent;
    filter: brightness(1.08);
  }
</style>
