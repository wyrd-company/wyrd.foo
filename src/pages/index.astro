---
/*
 * The home page (REDESIGN.md, "Home page"): headline, the featured card
 * beside Recent releases, then the catalog with kind tabs.
 */
import { getCollection } from "astro:content";
import HomeCatalog from "../components/home/HomeCatalog.astro";
import HomeFeatured from "../components/home/HomeFeatured.astro";
import HomeReleases from "../components/home/HomeReleases.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { pickFeatured } from "../lib/featured";
import { catalogRows, featuredCandidates, featuredCards, recentReleases, type HomeEntry } from "../lib/home";

const [products, pages] = await Promise.all([getCollection("products"), getCollection("pages")]);
const withDocs = new Set(pages.map((page) => page.data.product));
const entries: HomeEntry[] = products.map((product) => ({
  key: product.id,
  data: product.data,
  hasDocs: withDocs.has(product.id),
}));

const candidates = featuredCandidates(entries);
const pick = pickFeatured(candidates, Date.now());
---

<SiteLayout
  nav="catalog"
  title="Wyrd Tools — small, sharp tools for the people and agents who ship"
  description="Single-purpose tools for developers and the agents that work alongside them."
>
  <section class="home-hero site-width">
    <h1>Small, sharp tools for the people <em>and agents</em> who ship.</h1>
    <p>
      Single-purpose instruments, each machined to do one thing exactly. Drafted because we needed them,
      tolerance-tested because we run them every day.
    </p>
  </section>

  <section class="home-spotlight site-width" aria-label="Featured and recent releases">
    <HomeFeatured cards={featuredCards(entries)} candidates={candidates} pick={pick} />
    <HomeReleases releases={recentReleases(entries)} />
  </section>

  <HomeCatalog rows={catalogRows(entries)} />
</SiteLayout>

<style>
  .home-hero {
    padding-top: 72px;
    padding-bottom: 40px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .home-hero h1 {
    margin: 0;
    max-width: 960px;
    font-size: clamp(36px, 5.2vw, 56px);
    line-height: 1.04;
    font-weight: 700;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .home-hero em {
    font-style: normal;
    color: var(--accent);
  }
  .home-hero p {
    margin: 0;
    max-width: 56ch;
    font-size: 19px;
    color: var(--text-2);
  }
  .home-hero > * {
    animation: home-rise 520ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .home-hero > :nth-child(2) {
    animation-delay: 90ms;
  }
  .home-spotlight {
    display: grid;
    grid-template-columns: minmax(0, 9fr) minmax(0, 3.4fr);
    gap: 24px;
    align-items: stretch;
    animation: home-rise 520ms 160ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  /* With no featured product, Recent releases takes the full width. */
  :global(.home-spotlight:has(> [data-home-featured][hidden])) {
    grid-template-columns: minmax(0, 1fr);
  }
  @media (max-width: 1100px) {
    .home-spotlight {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @keyframes home-rise {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .home-hero > *,
    .home-spotlight {
      animation: none;
    }
  }
</style>
