---
/*
 * The page layout for every page: the shared head and the page content.
 */
import SiteHead from "../components/SiteHead.astro";
import type { HeadProduct } from "../lib/head";

interface Props {
  title: string;
  description?: string;
  /** The product this page belongs to: its favicon and social image. */
  product?: HeadProduct;
}
const { title, description, product } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead title={title} description={description} product={product} />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
