---
/*
 * The page layout for every page: the shared head, the site header, the page
 * content and the footer. A page can replace the header with its own through
 * the "header" slot (the docs pages have a two-row header).
 */
import type { IssueReportProduct } from "../lib/issue-report";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHead from "../components/SiteHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import type { HeadProduct } from "../lib/head";
import type { NavItem } from "../lib/site";

interface Props {
  title: string;
  reportProduct?: IssueReportProduct;
  description?: string;
  /** The product this page belongs to: its favicon and social image, and
   * search ranks its results first. */
  product?: HeadProduct & { key: string };
  /** The header nav item for this page. */
  nav?: NavItem;
  /** The page is served at URLs that are not its own (the 404 page). */
  noindex?: boolean;
}
const { title, description, product, nav, noindex, reportProduct } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead title={title} description={description} product={product} noindex={noindex} />
  </head>
  <body>
    <slot name="header">
      <SiteHeader current={nav} product={product?.key} productName={product?.name} />
    </slot>
    <main class="site-main">
      <slot />
    </main>
    <SiteFooter title={title} pageUrl={new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href} reportProduct={reportProduct} />
  </body>
</html>
